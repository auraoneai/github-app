{
  "root": true,
  "extends": ["eslint:recommended"],
  "env": {
    "commonjs": true,
    "es2022": true,
    "node": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "MemberExpression[object.name='Math'][property.name='random']",
        "message": "Use secure-random.ts instead of Math.random() in deployed environments code. Math.random() is not cryptographically secure and should only be used in test files, stories, or runtime code."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.js",
        "**/*.spec.js",
        "**/__tests__/**/*",
        "**/tests/**/*",
        "**/fixtures/**/*"
      ],
      "rules": {
        "no-restricted-syntax": "off"
      }
    }
  ]
}
