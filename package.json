{
  "name": "@auraone/github-app",
  "version": "1.0.0",
  "description": "Self-hosted GitHub App for AI evaluation Check Runs: runs AuraOne evaluation templates on pull requests.",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "jest",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "keywords": [
    "github-app",
    "github-checks",
    "ai-evaluation",
    "llm-evaluation",
    "pull-request",
    "self-hosted",
    "auraone"
  ],
  "author": "AuraOne Team",
  "license": "MIT",
  "dependencies": {
    "@octokit/app": "14.1.0",
    "@octokit/webhooks": "12.3.2",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@auraone/sdk": "workspace:^1.0.0",
    "eslint": "8.57.1",
    "jest": "29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auraoneai/github-app.git"
  },
  "homepage": "https://auraone.ai/open/github-app",
  "bugs": {
    "url": "https://github.com/auraoneai/github-app/issues"
  },
  "files": [
    "src",
    "app.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@auraone/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@auraone/sdk": {
      "optional": false
    }
  }
}