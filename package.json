{
  "name": "@auraone/github-app",
  "version": "1.0.0",
  "description": "GitHub App for automated AuraOne evaluations on pull requests",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "jest",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix"
  },
  "keywords": [
    "github",
    "app",
    "ci-cd",
    "aura-one",
    "ai",
    "agents",
    "evaluation",
    "automation"
  ],
  "author": "AuraOne Team",
  "license": "MIT",
  "dependencies": {
    "@octokit/app": "14.1.0",
    "@octokit/webhooks": "12.3.2",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@auraone/sdk": "workspace:^1.0.0",
    "eslint": "8.57.1",
    "jest": "29.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/auraoneai/AuraOne.git",
    "directory": "sdks/github-app"
  },
  "files": [
    "src",
    "app.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@auraone/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@auraone/sdk": {
      "optional": false
    }
  }
}